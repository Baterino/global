# Copy to .env and fill in values

# Database - Railway provides this when you add Postgres
DATABASE_URL="postgresql://user:password@host:port/database?sslmode=require"

# JWT secret (openssl rand -base64 32) — required for /api/admin/* (login, CMS)
JWT_SECRET="your-secret-key"

# Admin credentials (used by seed)
ADMIN_EMAIL="admin@baterino.com"
ADMIN_PASSWORD="your-secure-password"

# Contact form (POST /api/contact)
# Production: set RESEND_API_KEY (HTTPS; works on Railway Hobby) OR full SMTP_* below.
# In development, if neither is set, submissions are logged to the console only.
# Defaults to inquiries@baterino.com if unset.
CONTACT_TO_EMAIL="inquiries@baterino.com"
# Display name in From / subjects / auto-reply (default: Baterino Global)
# CONTACT_MAIL_DISPLAY_NAME="Baterino Global"

# Resend (https://resend.com) — preferred on hosts that block outbound SMTP
# RESEND_API_KEY="re_..."
# Verified sender domain in Resend; can be "Name <no-reply@yourdomain.com>" or just the email.
# RESEND_FROM_EMAIL="Baterino <no-reply@baterino.com>"

# Optional: From for internal notification when not using RESEND_FROM_EMAIL (falls back to CONTACT_FROM_EMAIL / SMTP_USER).
# CONTACT_FROM_EMAIL="noreply@yourdomain.com"
# Customer auto-reply "From" for SMTP path; with Resend, use a verified address (often same domain as RESEND_FROM_EMAIL).
# AUTO_REPLY_FROM_EMAIL="global@baterino.com"
# Public site URL (SEO, defaults). Trailing slash optional.
SITE_PUBLIC_URL="https://baterino.com"
# If the contact API runs on a different host (e.g. api.*.vercel.app), set this to the **live website**
# that serves /images (logo + email icons) so auto-reply HTML loads images (no trailing slash).
# CONTACT_EMAIL_PUBLIC_ORIGIN="https://baterino.com"
# Social links in customer confirmation email (optional; default baterino.com until set)
# SOCIAL_FACEBOOK_URL="https://www.facebook.com/profile.php?id=61575386571436"
# SOCIAL_LINKEDIN_URL="https://www.linkedin.com/company/baterino-global/"
# SMTP fallback (e.g. local dev or non-Resend hosts)
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER="your-smtp-user"
# SMTP_PASS="your-smtp-password"
# Set to "true" for port 465 implicit TLS
# SMTP_SECURE="false"
# Port 587: require STARTTLS (default true). Set to "false" only if your host breaks on upgrade.
# SMTP_REQUIRE_TLS="true"

# Cloudflare R2 (S3-compatible) — public images for CMS articles / use cases
# Bucket layout: articles/{articleId}/...  and  use-cases/{projectId}/...
# Create API token with Object Read & Write.
#
# R2_PUBLIC_URL must be the bucket’s BROWSER-PUBLIC hostname — NOT the S3 API endpoint:
#   YES: https://pub-xxxxx.r2.dev   (R2 → bucket → Settings → Public access → r2.dev)
#   YES: https://media.yourdomain.com   (custom domain on the bucket)
#   NO:  https://<accountid>.r2.cloudflarestorage.com  ← uploads may work; images will NOT load on Vercel
#
# R2_ACCOUNT_ID="your_cloudflare_account_id"
# Optional alias: CLOUDFLARE_ACCOUNT_ID (same value as R2 account id)
# R2_ACCESS_KEY_ID="..."
# R2_SECRET_ACCESS_KEY="..."
# Optional S3-compatible aliases (same R2 API token): AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY
# R2_BUCKET_NAME="baterino-media"   # exact dashboard name only, lowercase, not a URL
# Optional alias: R2_BUCKET
# R2_PUBLIC_URL="https://pub-xxxxx.r2.dev"
#
# Static site images (apps/web/public/images → R2) — optional if you use a dedicated bucket:
#   pnpm --filter api sync:public-images        # upload
#   pnpm --filter api sync:public-images --dry-run
# Keys are images/<same path as repo>, e.g. images/Home/bess-solutions.jpg → public URL <public>/images/Home/…
# Optimize locally first (optional): pnpm --filter web optimize:usecases  (and other web image scripts).
# R2_IMAGES_BUCKET_NAME="baterino-static-images"
# R2_IMAGES_PUBLIC_URL="https://pub-yyyyy.r2.dev"   # public access URL for THAT bucket (no trailing slash)
# If the static-images bucket uses a different API token than the media bucket:
# R2_IMAGES_ACCESS_KEY_ID="..."
# R2_IMAGES_SECRET_ACCESS_KEY="..."
# Optional if same Cloudflare account as R2_ACCOUNT_ID: R2_IMAGES_ACCOUNT_ID="..."
#
# Railway: set all of the above on the API service (Variables). Updating local .env does not change production.
