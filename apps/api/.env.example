# Copy to .env and fill in values

# Database - Railway provides this when you add Postgres
DATABASE_URL="postgresql://user:password@host:port/database?sslmode=require"

# JWT secret (openssl rand -base64 32)
JWT_SECRET="your-secret-key"

# Admin credentials (used by seed)
ADMIN_EMAIL="admin@baterino.com"
ADMIN_PASSWORD="your-secure-password"

# Contact form (POST /api/contact)
# In development, if SMTP is omitted, submissions are logged to the console only.
# Defaults to alexander@baterino.com if unset.
CONTACT_TO_EMAIL="alexander@baterino.com"
# Optional: From address for outbound mail (must be allowed by your SMTP provider)
# CONTACT_FROM_EMAIL="noreply@yourdomain.com"
# From address for customer auto-reply (must be verified with your mail provider, e.g. global@baterino.com)
# AUTO_REPLY_FROM_EMAIL="global@baterino.com"
# Public site URL for logo image in auto-reply emails (no trailing slash)
SITE_PUBLIC_URL="https://baterino.com"
# Social links in customer confirmation email (optional; default baterino.com until set)
# SOCIAL_FACEBOOK_URL="https://www.facebook.com/yourpage"
# SOCIAL_LINKEDIN_URL="https://www.linkedin.com/company/yourcompany"
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="your-smtp-user"
SMTP_PASS="your-smtp-password"
# Set to "true" for port 465 implicit TLS
# SMTP_SECURE="false"
