{
  "name": "api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "db:apply-pending": "tsx src/scripts/applyPendingMigrations.ts",
    "db:seed": "tsx src/scripts/seedAdmin.ts",
    "db:seed:insights": "tsx src/scripts/seedInsightsArticles.ts",
    "db:migrate:prod": "node dist/scripts/migrate.js",
    "db:seed:prod": "node dist/scripts/seedAdmin.js",
    "test:r2": "tsx src/scripts/testR2.ts",
    "sync:public-images": "tsx src/scripts/syncPublicImagesToR2.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1016.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.3",
    "pg": "^8.13.1",
    "resend": "^4.0.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.10.0",
    "@types/nodemailer": "^7.0.11",
    "@types/pg": "^8.11.10",
    "@vercel/node": "^3.2.27",
    "tsx": "^4.6.0",
    "typescript": "~5.3.0"
  }
}
