{
  "buildCommand": "cd ../.. && pnpm --filter web build",
  "outputDirectory": "dist",
  "installCommand": "cd ../.. && pnpm install",
  "framework": null,
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/contact.ts": {
      "includeFiles": "../api/src/contact/**"
    }
  }
}
