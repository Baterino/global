# Canonical URL and sitemap base URL (used at build time)
VITE_SITE_URL=https://example.com

# Optional: serve /images/* from Cloudflare R2 (same origin as R2_IMAGES_PUBLIC_URL, no trailing slash).
# After `pnpm --filter api sync:public-images`, set this to that bucket’s public URL so the site loads images from CDN.
# VITE_ASSET_BASE_URL=https://pub-yyyyy.r2.dev

# API origin (browser calls this host for admin + public JSON).
# Local: leave unset so requests use /api/… and Vite proxies to http://localhost:3001 (run the API there).
# Or set explicitly: VITE_API_URL=http://localhost:3001
# Production (Vercel): VITE_API_URL=https://your-railway-api.up.railway.app
# VITE_API_URL=https://api.example.com

# Social (optional — Footer & contact email preview; defaults are set in socialLinks.ts)
# VITE_SOCIAL_FACEBOOK_URL=https://www.facebook.com/profile.php?id=61575386571436
# VITE_SOCIAL_LINKEDIN_URL=https://www.linkedin.com/company/baterino-global/

# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID=
